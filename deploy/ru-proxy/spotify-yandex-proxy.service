[Unit]
Description=SpotifyBot private Yandex HTTP proxy through RU
Requires=baloonz-gre.service
After=network-online.target baloonz-gre.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/opt/baloonz-gost/gost -L http://10.243.93.1:21081
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=64M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
